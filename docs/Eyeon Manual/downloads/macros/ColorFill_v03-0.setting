{
	Tools = ordered() {
		ColorFill = MacroOperator {
			CustomData = {
				HelpPage = "http://vfxpedia.com/index.php?title=Settings_and_Macros/ColorFill_Description",
			},
			Inputs = ordered() {
				Comments = Input { Value = "Solid Color Fill for Fusion 5.21 and above\n\nIn v_03-0:\nApply modes, optimized pre-divide/post-multiply\n\nby Gregory Chalenko\r\nwww.compositing.ru", },
				Input = InstanceInput {
					SourceOp = "AlphaDivide1",
					Source = "Input",
				},
				EffectMask = InstanceInput {
					SourceOp = "CT_Operation",
					Source = "EffectMask",
				},
				ProcessRedClone = InstanceInput {
					SourceOp = "CT_Operation",
					Source = "ProcessRed",
					Default = 1,
				},
				ProcessGreenClone = InstanceInput {
