					SourceOp = "CT_Operation",
					Source = "ProcessBlue",
					Default = 1,
				},
				ProcessAlphaClone = InstanceInput {
					SourceOp = "CT_Operation",
					Source = "ProcessAlpha",
					Default = 0,
				},
				Red = InstanceInput {
					SourceOp = "CT_Operation",
