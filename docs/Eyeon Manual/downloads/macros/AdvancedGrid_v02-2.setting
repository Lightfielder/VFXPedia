						},
						TopLeftAlpha = Input {
							Value = 0,
						},
				GradientType = Input {
					Value = FuID { "Cross", },
					Expression = "(Pattern == 0) and \"Reflect\" or (Pattern == 1) and \"Square\" or (Pattern == 2) and \"Cross\" or \"Radial\"",
				},
						Start = Input {
							Value = { 0.5, 0.5, },
						},
						Gradient = Input {
							Value = Gradient {
								Colors = {
									[0.15] = { 0.9, 0.6, 0.1, 1, },
									[0.16] = { 0, 0, 0, 0, },
