					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input {
							Value = 2048,
							Expression = "Height",
						},
						Height = Input {
							Value = 2048,
							Expression = "(Background.Output.OriginalWidth*Background.Output.XScale>Background.Output.OriginalHeight*Background.Output.YScale) and Background.Output.OriginalWidth*Background.Output.XScale or Background.Output.OriginalHeight*Background.Output.YScale",
						},
						Type = Input {
							Value = FuID { "Gradient", },
						},
						TopLeftRed = Input {
							Value = 1,
