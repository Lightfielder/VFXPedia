									[0.31] = { 0.7, 0.7, 0.2, 1, },
									[0.36] = { 0.7, 0.7, 0.2, 1, },
									[0.37] = { 0, 0, 0, 0, },
								},
							},
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 60.768, 41.65, },
					},
			UserControls = ordered() {
				Pattern = {
