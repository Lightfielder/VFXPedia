					Inputs = {
						ColorSpaceConversion = Input { Value = 1, },
						ColorType = Input {
							Value = 4,
							Expression = "iif(BC_LuminanceControl.LuminanceSubtractionMode<2, BC_LuminanceControl.LuminanceSubtractionMode, 4)",
						},
