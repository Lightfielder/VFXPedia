{
	Tools = ordered() {
		Refraction = MacroOperator {
			CustomData = {
				HelpPage = "http://vfxpedia.com/index.php?title=Settings_and_Macros/Refraction_Description",
			},
			Inputs = ordered() {
				Comments = Input {
					Value = "Refraction for Fusion 6 and above. Distorts an image based on a height map.\n\nIn v06-7: Name of the macro in the Display View. No processing when Blend=0 (instancing warning)\n\nby Gregory Chalenko\r\nwww.compositing.ru",
				},
				Input = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "Image1",
					Name = "Image to Distort",
				},
				RefractionMap = InstanceInput {
					SourceOp = "MapBlur",
					Source = "Input",
					Name = "Refraction Map",
				},
				RefractionPower = InstanceInput {
					SourceOp = "Bol_Power",
					Source = "Foreground",
					Name = "Refraction Power",
				},
				EffectMask = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "EffectMask",
				},
				MapBlur = InstanceInput {
					SourceOp = "MapBlur",
					Source = "XBlurSize",
					Name = "Map Blur",
					Default = 10,
				},
				SourceChannel = InstanceInput {
					SourceOp = "CreateBumpMap",
					Source = "SourceChannel",
				},
				RefractionStrength = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn1",
					Default = 1,
				},
				HorizontalStrengthMultiplier = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn2",
					Default = 1,
				},
				VerticalStrengthMultiplier = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn3",
					Default = 1,
				},
				UsePowerMap = InstanceInput {
					SourceOp = "Bol_Power",
					Source = "UsePowerMap",
				},
				EnableDispersion = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "EnableDispersion",
				},
				RGBMultipliers = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "LUTControls",
					Default = 1,
					Name = "RGB Multipliers",
				},
				RedStrengthMultiplier = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn4",
					Default = 1.02,
				},
				GreenStrengthMultiplier = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn5",
					Default = 1.01,
				},
				BlueStrengthMultiplier = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "NumberIn6",
					Default = 1,
				},
				Blend = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "Blend",
					Page = "Common Controls"
				},
				ProcessWhenBlendIs00 = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ProcessWhenBlendIs00",
				},
				ProcessRed = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ProcessRed",
				},
				ProcessGreen = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ProcessGreen",
				},
				ProcessBlue = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ProcessBlue",
				},
				ProcessAlpha = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ProcessAlpha",
				},
				ApplyMaskInverted = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "ApplyMaskInverted",
				},
				MultiplyByMask = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "MultiplyByMask",
				},
				MaskChannel = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "MaskChannel",
				},
				MaskHigh = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "MaskHigh",
					ControlGroup = 4,
				},
				MaskLow = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "MaskLow",
					ControlGroup = 4,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "RefractionMacro",
					Source = "Output",
				},
			},
			Tools = ordered() {
				MapBlur = Blur {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						XBlurSize = Input {
							Value = 10,
						},
						YBlurSize = Input {
							Disabled = true,
						},
						Blend = Input { Expression = "iif(RefractionMacro.Blend+RefractionMacro.ProcessWhenBlendIs00==0, 0, 1)", },
					},
					ViewInfo = OperatorInfo {
						Pos = { -16.16, 20.15, },
					},
					Colors = {
						TileColor = { R = 0.423529411764706, G = 0.498039215686275, B = 0.329411764705882, },
						TextColor = { R = 0.862745098039216, G = 0.862745098039216, B = 0.862745098039216, },
					},
				},
				RefractionMacro = Custom {
					CtrlWShown = false,
					Inputs = {
						NumberIn1 = Input {
							Value = 1,
						},
						NumberIn2 = Input {
							Value = 1,
						},
						NumberIn3 = Input {
							Value = 1,
						},
						NumberIn4 = Input {
							Value = 1.02,
						},
						NumberIn5 = Input {
							Value = 1.01,
						},
						NumberIn6 = Input {
							Value = 1,
						},
						LUTControls = Input {
							Value = 1,
						},
						Intermediate1 = Input { Value = "r2*n1*n2", },
						Intermediate2 = Input { Value = "g2*n1*n3", },
						RedExpression = Input {
							Value = "getr1w(x+i1,y+i2)",
							Expression = "Text(iif(EnableDispersion==1, \"getr1w(x+i1*n4,y+i2*n4)\", \"getr1w(x+i1,y+i2)\" ))",
						},
						GreenExpression = Input {
							Value = "getg1w(x+i1,y+i2)",
							Expression = "Text(iif(EnableDispersion==1, \"getg1w(x+i1*n5,y+i2*n5)\", \"getg1w(x+i1,y+i2)\" ))",
						},
						BlueExpression = Input {
							Value = "getb1w(x+i1,y+i2)",
							Expression = "Text(iif(EnableDispersion==1, \"getb1w(x+i1*n6,y+i2*n6)\", \"getb1w(x+i1,y+i2)\" ))",
						},
						AlphaExpression = Input { Value = "geta1w(x+i1,y+i2)", },
						NameforNumber1 = Input { Value = "Refraction Strength", },
						NameforNumber2 = Input { Value = "Horizontal Strength Multiplier", },
						NameforNumber3 = Input { Value = "Vertical Strength Multiplier", },
						NameforNumber4 = Input { Value = "Red Strength Multiplier", },
						NameforNumber5 = Input { Value = "Green Strength Multiplier", },
						NameforNumber6 = Input { Value = "Blue Strength Multiplier", },
						Image2 = Input {
							SourceOp = "Bol_Power",
							Source = "Output",
						},
						Image3 = Input {
							SourceOp = "BG_Power",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { -13.07, 99.683, },
					},
			UserControls = ordered() {
				EnableDispersion = {
					LINKS_Name = "Enable Dispersion",
					LINKID_DataType = "Number",
					IC_ControlPage = 3,
					INPID_InputControl = "CheckboxControl",
					INP_Default = 0,
				},
			},
				},
				CreateBumpMap = CreateBumpMap {
					CtrlWShown = false,
					Inputs = {
						Input = Input {
							SourceOp = "MapBlur",
							Source = "Output",
						},
						HeightScale = Input {
							Value = 4,
						},
						BumpmapTextureDepth = Input {
							Value = 4,
						},
						Blend = Input { Expression = "iif(RefractionMacro.Blend+RefractionMacro.ProcessWhenBlendIs00==0, 0, 1)", },
					},
					ViewInfo = OperatorInfo {
						Pos = { -16.16, 53.15, },
					},
				},
				BrightnessContrast_3_1_2 = BrightnessContrast {
					Inputs = {
						Brightness = Input { Value = -0.5, },
						Blend = Input { Expression = "iif(RefractionMacro.Blend+RefractionMacro.ProcessWhenBlendIs00==0, 0, 1)", },
						Input = Input {
							SourceOp = "CreateBumpMap",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 17.2873, 118.83, }, },
					Colors = {
						TileColor = { R = 0.666666666666667, G = 0.505882352941176, B = 0.235294117647059, },
						TextColor = { R = 0.862745098039216, G = 0.862745098039216, B = 0.862745098039216, },
					},
				},
		Bol_Power = ChannelBoolean {
			CtrlWZoom = false,
			Inputs = {
				Blend = Input {
					Value = 0,
					Expression = "iif((RefractionMacro.Blend+RefractionMacro.ProcessWhenBlendIs00)*UsePowerMap==0, 0, 1)",
					},
				Operation = Input { Value = 6, },
				ToRed = Input { Value = 3, },
				ToGreen = Input { Value = 3, },
				ToBlue = Input { Value = 4, },
				ToAlpha = Input { Value = 4, },
				Background = Input {
					SourceOp = "BrightnessContrast_3_1_2",
					Source = "Output",
				},
			},
			ViewInfo = OperatorInfo {
				Pos = { -54.5784, 103.368, },
			},
			Colors = {
				TileColor = { R = 0.666666666666667, G = 0.501960784313725, B = 0.235294117647059, },
				TextColor = { R = 0.862745098039216, G = 0.862745098039216, B = 0.862745098039216, },
			},
			UserControls = ordered() {
				UsePowerMap = {
					LINKS_Name = "Use Power Map",
