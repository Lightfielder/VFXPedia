{
	Tools = ordered() {
		MotionVectorsCorrection = MacroOperator {
			CustomData = {
				HelpPage = "http://vfxpedia.com/index.php?title=Settings_and_Macros/MotionVectorsCorrection_Description",
			},
			Inputs = ordered() {
				Comments = Input {
					Value = "Lets you modify motion vector map in case the position of your 3D-object is animated in 2D with tracking or other kind of 2D-animation to achieve correct resulting power and direction of the motion blur.\nConnect the Center parameter to the animation you apply to the 3D-object. Set the Magnitude to adjust the power of the correction.\nMotion blur in the transform tools must be switched off.\n\nby Gregory Chalenko\nwww.compositing.ru",
				},
				Input = InstanceInput {
					SourceOp = "CustomTool",
					Source = "Image1",
					Name = "Vector Data (Red and Green)",
				},
				Center = InstanceInput {
					SourceOp = "CustomTool",
					Source = "PointIn1",
				},
				Magnitude = InstanceInput {
					SourceOp = "CustomTool",
					Source = "NumberIn3",
					Default = 1,
				},
			},
			Outputs = {
				Output = InstanceOutput {
					SourceOp = "CustomTool",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0, },
			},
			Tools = ordered() {
				CustomTool = Custom {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input {
							Expression = "CustomTool:GetValue(\"PointIn1\", time+1).X-PointIn1.X",
						},
						NumberIn2 = Input {
							Expression = "CustomTool:GetValue(\"PointIn1\", time+1).Y-PointIn1.Y",
						},
						NumberIn3 = Input {
							Value = 1,
						},
						RedExpression = Input {
							Value = "r1+n1*n3",
						},
						GreenExpression = Input {
							Value = "g1+n2*n3*h/w",
						},
						NumberControls = Input {
							Value = 1,
						},
						NameforNumber1 = Input {
							Value = "X Velocity",
						},
						NameforNumber2 = Input {
							Value = "Y Velocity",
						},
						NameforNumber3 = Input {
							Value = "Magnitude",
						},
						ShowNumber4 = Input {
							Value = 0,
						},
						ShowNumber5 = Input {
							Value = 0,
						},
						ShowNumber6 = Input {
							Value = 0,
						},
						ShowNumber7 = Input {
							Value = 0,
						},
						ShowNumber8 = Input {
							Value = 0,
						},
						PointControls = Input {
							Value = 1,
						},
						NameforPoint1 = Input {
							Value = "Center",
						},
						ShowPoint2 = Input {
							Value = 0,
						},
						ShowPoint3 = Input {
							Value = 0,
						},
						ShowPoint4 = Input {
							Value = 0,
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 592, 116, },
					},
				},
			},
		},
	},
	ActiveTool = "MotionVectorsCorrection",
}