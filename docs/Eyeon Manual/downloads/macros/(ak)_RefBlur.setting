			Inputs = ordered() {
				Comments = Input {
					Value = "Applies motion blur based on the Center, Pivot, and Angle animation. Turn up Edge Bleed to kill motion blur that wraps from the other side of the image. Note: Edge Bleed value will increase render time, use conservatively.",
