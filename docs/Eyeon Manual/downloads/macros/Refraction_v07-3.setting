{
	Tools = ordered() {
		Refraction = MacroOperator {
			CustomData = {
				HelpPage = "http://vfxpedia.com/index.php?title=Settings_and_Macros/Refraction_Description",
			},
			Inputs = ordered() {
				Comments = Input {
					Value = "Refraction for Fusion 6 and above. Distorts an image based on a height map.\n\nIn v07-3:\nMotion blur parameters. For better motion blur see the documentation (F1 on the macro node)\n\nby Gregory Chalenko\r\nwww.compositing.ru",
				},
				Input = InstanceInput {
					SourceOp = "RefractionMacro",
					Source = "Image1",
					Name = "Image to Distort",
				},
				RefractionMap = InstanceInput {
