						},
						NumberIn6 = Input {
							Value = 1,
						},
						LUTControls = Input {
							Value = 1,
						},
						RedExpression = Input {
							Expression = "Text(iif(EnableDispersion==1, \"getr1w(x+r2*n4,y+g2*n4)\", \"getr1w(x+r2,y+g2)\" ))",
						},
						GreenExpression = Input {
							Expression = "Text(iif(EnableDispersion==1, \"getg1w(x+r2*n5,y+g2*n5)\", \"getg1w(x+r2,y+g2)\" ))",
						},
						BlueExpression = Input {
							Expression = "Text(iif(EnableDispersion==1, \"getb1w(x+r2*n6,y+g2*n6)\", \"getb1w(x+r2,y+g2)\" ))",
						},
						AlphaExpression = Input {
							Value = "geta1w(x+r2,y+g2)",
						},
						NameforNumber4 = Input { Value = "Red Strength Multiplier", },
						NameforNumber5 = Input { Value = "Green Strength Multiplier", },
						NameforNumber6 = Input { Value = "Blue Strength Multiplier", },
						Image2 = Input {
							SourceOp = "Bol_Power",
							Source = "Output",
						},
						Image3 = Input {
							SourceOp = "BG_Power",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { -13.07, 99.683, },
					},
			UserControls = ordered() {
				EnableDispersion = {
