					SourceOp = "RefractionMacro",
					Source = "Output",
				},
			},
			Tools = ordered() {
				MapBlur = Blur {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
					Filter = Input { Value = FuID { "Multi-box", }, },
						XBlurSize = Input {
							Value = 0,
--							Expression = "SoftenRefractionMap*720",
