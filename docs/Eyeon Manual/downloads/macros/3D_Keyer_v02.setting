						},
						LUTIn4 = Input {
							SourceOp = "Key3DLUTIn4",
							Source = "Value",
						},
						Intermediate1 = Input { Value = "min(1, abs(r1-n1)+abs(g1-n2)+abs(b1-n3))", },
						Intermediate2 = Input { Value = "min(1, sqrt((r1-n1)^2 + (g1-n2)^2 + (b1-n3)^2))", },
						AlphaExpression = Input { Value = "if(n4 == 0, i1, i2)", },
