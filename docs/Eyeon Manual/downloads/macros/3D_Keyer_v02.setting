{
	Tools = ordered() {
		ThreeDKeyer = MacroOperator {
			CustomData = {
				HelpPage = "http://www.vfxpedia.com/index.php?title=Settings_and_Macros/3D_Keyer_Description",
			}, 
			Inputs = ordered() {
				Input = InstanceInput {
					SourceOp = "ThreeDKeyer_Input",
