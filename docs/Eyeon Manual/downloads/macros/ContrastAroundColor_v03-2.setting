				},
				MultiplyByMask = InstanceInput {
					SourceOp = "CC_Contrast",
					Source = "MultiplyByMask",
				},
				MaskChannel = InstanceInput {
					SourceOp = "CC_Contrast",
					Source = "MaskChannel",
				},
				MaskHigh = InstanceInput {
					SourceOp = "CC_Contrast",
					Source = "MaskHigh",
