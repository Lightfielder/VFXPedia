					SourceOp = "CC_Contrast",
					Source = "EffectMask",
				},
			},
			Outputs = {
				Output = InstanceOutput {
					SourceOp = "CC_RestoreBlack",
					Source = "Output",
				},
			},
			Tools = ordered() {
				CC_ShiftBlack = ColorCorrector {
					NameSet = true,
					Inputs = {
						MasterRGBGamma = Input { Expression = "iif(PerformGammaCompensation==1,GammaCompensation,1)", },
						MasterRedBrightness = Input { Expression = "-Red^(1/MasterRGBGamma)", },
						MasterGreenBrightness = Input { Expression = "-Green^(1/MasterRGBGamma)", },
						MasterBlueBrightness = Input { Expression = "-Blue^(1/MasterRGBGamma)", },
