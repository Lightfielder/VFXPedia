						MasterRedBrightness = Input { Expression = "-CC_ShiftBlack.MasterRedBrightness", },
						MasterGreenBrightness = Input { Expression = "-CC_ShiftBlack.MasterGreenBrightness", },
						MasterBlueBrightness = Input { Expression = "-CC_ShiftBlack.MasterBlueBrightness", },
						Input = Input {
							SourceOp = "CC_Contrast",
