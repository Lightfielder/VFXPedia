				},
				MaskLow = InstanceInput {
					SourceOp = "CC_Contrast",
					Source = "MaskLow",
					ControlGroup = 5,
				},
				Input = InstanceInput {
					SourceOp = "CC_ShiftBlack",
					Source = "Input",
				},
