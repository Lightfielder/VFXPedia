		if selected == 1 and groups[id] then
			if groups[id][2] then
				groups[id][2]()					-- call setup func
			end
			zbox.value = groups[id][1]
		end
		return iup.DEFAULT
	end
	
	function list_num_ic:action (t, o, sel)
		return SelectParams(ctrl_groups, zbox_ic, t, sel)
