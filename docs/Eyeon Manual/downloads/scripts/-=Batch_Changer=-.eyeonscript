								lst;
								gap=5
						  };
						  title="Choose Parameter",
						  size="300x50",
						  fgcolor=active
					 }
				},
				iup.hbox{
					 iup.frame{
						  setList;
						  title="Set To:",
						  size="300x110",
						  fgcolor=active
					 }
				},

		  },
		  iup.vbox{
				iup.frame{
					 iup.vbox{
						  listFuID;
						  gap=5
					 };
					 size="100x150"
				}
		  }
	 };
	 margin="10x10",
	 title="© 2007 SlayerK Multiple Parameter Changer",
	 resize="no",
	 bgcolor="64 64 64"
}

dlg:show()
iup.MainLoop()
